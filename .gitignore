# Data — regenerate from the pipeline, too large for Git
data/raw/
data/processed/
data/external/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Environment
.env
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Firebase
.firebase/
*-debug.log

# Vercel and Firebase secrets - never commit a service account key
.vercel/
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
