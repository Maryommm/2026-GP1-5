rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasVerifiedEmail() {
      return request.auth != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email is string;
    }

    function ownsProfile(uid) {
      return hasVerifiedEmail() && request.auth.uid == uid;
    }

    function validUsername(username) {
      return username is string &&
          username.size() >= 3 &&
          username.size() <= 20 &&
          username.matches('^[a-zA-Z0-9_.]+$');
    }

    function validNormalizedUsername(username) {
      return username is string &&
          username.size() >= 3 &&
          username.size() <= 20 &&
          username.matches('^[a-z0-9_.]+$');
    }

    function validProfile(data) {
      return data.keys().hasAll(
              ['username', 'normalizedUsername', 'email', 'createdAt']) &&
          data.keys().hasOnly(
              ['username', 'normalizedUsername', 'email', 'createdAt']) &&
          validUsername(data.username) &&
          validNormalizedUsername(data.normalizedUsername) &&
          data.normalizedUsername == data.username.trim().lower() &&
          data.email is string &&
          data.email == request.auth.token.email;
    }

    match /users/{uid} {
      allow read: if ownsProfile(uid) && hasVerifiedEmail();

      allow create: if ownsProfile(uid) &&
          validProfile(request.resource.data) &&
          request.resource.data.createdAt == request.time &&
          !exists(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)) &&
          existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)) &&
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.keys().hasOnly(['uid']) &&
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.uid == uid;

      // Username change (Edit Profile). Only the owner, only the username
      // fields; email and createdAt must stay the same.
      allow update: if ownsProfile(uid) &&
          validProfile(request.resource.data) &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            // Same name, only capitalization changed: the reservation stays.
            request.resource.data.normalizedUsername == resource.data.normalizedUsername ||
            // New name: reserve it for this user and release the old one in the same write.
            (
              !exists(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)) &&
              getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.uid == uid &&
              !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.normalizedUsername))
            )
          );

      allow delete: if false;
    }

    match /usernames/{normalizedUsername} {
      allow get: if hasVerifiedEmail();
      allow list: if false;

      allow create: if hasVerifiedEmail() &&
          validNormalizedUsername(normalizedUsername) &&
          request.resource.data.keys().hasAll(['uid']) &&
          request.resource.data.keys().hasOnly(['uid']) &&
          request.resource.data.uid == request.auth.uid &&
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          validProfile(
              getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername == normalizedUsername &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdAt == request.time;

      // Rename: the user's profile already exists, used a different name
      // before this write, and uses this name after it.
      allow create: if hasVerifiedEmail() &&
          validNormalizedUsername(normalizedUsername) &&
          request.resource.data.keys().hasAll(['uid']) &&
          request.resource.data.keys().hasOnly(['uid']) &&
          request.resource.data.uid == request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername != normalizedUsername &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername == normalizedUsername;

      allow update: if false;

      // Release an old name: only its owner, and only once their profile no
      // longer uses it.
      allow delete: if hasVerifiedEmail() &&
          resource.data.uid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername != normalizedUsername;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
