rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Require an authenticated user with a verified email.
    function hasVerifiedEmail() {
      return request.auth != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email is string;
    }

    // ---- Sprint 2 farm data ------------------------------------------------

    // The farm belongs to the signed-in user with this uid.
    function ownsFarm(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // "HH:mm", 24-hour.
    function validTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // A care schedule {everyDays, time}, or null when switched off
    // (see CareSchedule in lib/models/farm_plant.dart).
    function validSchedule(schedule) {
      return schedule == null || (
          schedule is map &&
          schedule.keys().hasAll(['everyDays', 'time']) &&
          schedule.keys().hasOnly(['everyDays', 'time']) &&
          schedule.everyDays in [1, 2, 3, 7, 14, 30] &&
          validTime(schedule.time));
    }

    // A plant (see FarmPlant.toMap). 9 lands of 25 squares at most.
    function validPlant(data) {
      return data.keys().hasAll(['cropId', 'name', 'category', 'land', 'square',
              'irrigation', 'fertilization', 'plantedAt', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['cropId', 'name', 'category', 'land', 'square',
              'irrigation', 'fertilization', 'plantedAt', 'createdAt', 'updatedAt']) &&
          data.cropId is string && data.cropId.size() > 0 && data.cropId.size() <= 40 &&
          data.name is string && data.name.size() > 0 && data.name.size() <= 30 &&
          data.category is string && data.category.size() <= 30 &&
          data.land is int && data.land >= 0 && data.land < 9 &&
          data.square is int && data.square >= 0 && data.square < 25 &&
          validSchedule(data.irrigation) &&
          validSchedule(data.fertilization) &&
          data.plantedAt is timestamp &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
    }

    // A growth photo's metadata, or null (see GrowthPhoto.toMap).
    function validGrowthPhoto(photo) {
      return photo == null || (
          photo is map &&
          photo.keys().hasAll(['publicId', 'version', 'format', 'width', 'height', 'bytes']) &&
          photo.keys().hasOnly(['publicId', 'version', 'format', 'width', 'height', 'bytes']) &&
          photo.publicId is string && photo.publicId.size() <= 200 &&
          photo.version is int && photo.version > 0 &&
          photo.format is string && photo.format.size() <= 10 &&
          photo.width is int && photo.width > 0 && photo.width <= 4096 &&
          photo.height is int && photo.height > 0 && photo.height <= 4096 &&
          photo.bytes is int && photo.bytes > 0 && photo.bytes <= 5 * 1024 * 1024);
    }

    // One step on a plant's growth timeline (see GrowthEntry.toMap).
    function validGrowthEntry(data) {
      return data.keys().hasAll(['date', 'notes', 'photo']) &&
          data.keys().hasOnly(['date', 'notes', 'photo']) &&
          data.date is timestamp &&
          (data.notes == null || (data.notes is string && data.notes.size() <= 500)) &&
          validGrowthPhoto(data.photo);
    }

    // One day's finished tasks (see TaskLog.toMap). Two tasks per plant and
    // 225 plants at most.
    function validTaskLog(data) {
      return data.keys().hasAll(['completed']) &&
          data.keys().hasOnly(['completed']) &&
          data.completed is list &&
          data.completed.size() <= 450;
    }

    // The streak and lands (see FarmStats.toMap).
    function validStats(data) {
      return data.keys().hasAll(['currentStreak', 'lastCompletedDate', 'lands']) &&
          data.keys().hasOnly(['currentStreak', 'lastCompletedDate', 'lands']) &&
          data.currentStreak is int && data.currentStreak >= 0 &&
          (data.lastCompletedDate == null ||
              (data.lastCompletedDate is string &&
               data.lastCompletedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
          data.lands is int && data.lands >= 1 && data.lands <= 9;
    }

    // The app only ever moves the streak up by one day, back by one (a task
    // un-ticked), to 0 (a day missed), or to 1 (a day missed, then today
    // completed, in the same write). Anything else would be a made-up
    // streak, e.g. to climb the leaderboard.
    function validStreakChange(before, after) {
      return after == before || after == before + 1 ||
          after == before - 1 || after == 0 || after == 1;
    }

    // Allow users to access only their own profile.
    function ownsProfile(uid) {
      return hasVerifiedEmail() && request.auth.uid == uid;
    }

    // Any username is allowed (same checks as UserService._isAllowedUsername):
    // not empty, at most 100 characters, and no "/".
    function validUsername(username) {
      return username is string &&
          username.size() >= 1 &&
          username.size() <= 100 &&
          !username.matches('.*/.*');
    }

    // The lowercase username is also the reservation's document name, so it
    // can't be "." or ".." or look like "__this__".
    function validNormalizedUsername(username) {
      return validUsername(username) &&
          username != '.' &&
          username != '..' &&
          !username.matches('^__.*__$');
    }

    // Allow only the expected profile fields and Firebase email.
    function validProfile(data) {
      return data.keys().hasAll(
              ['username', 'normalizedUsername', 'email', 'createdAt']) &&
          data.keys().hasOnly(
              ['username', 'normalizedUsername', 'email', 'createdAt']) &&
          validUsername(data.username) &&
          validNormalizedUsername(data.normalizedUsername) &&
          data.normalizedUsername == data.username.trim().lower() &&
          data.email is string &&
          data.email == request.auth.token.email;
    }

    // Validate profile-image metadata before storing it.
    function validProfileImage(uid, data) {
      return data.keys().hasAll(
              ['publicId', 'version', 'format', 'width', 'height', 'bytes', 'updatedAt']) &&
          data.keys().hasOnly(
              ['publicId', 'version', 'format', 'width', 'height', 'bytes', 'updatedAt']) &&
          data.publicId == 'ethmar/profile-images/' + uid + '/profile' &&
          data.version is int &&
          data.version > 0 &&
          data.format == 'webp' &&
          data.width is int &&
          data.width > 0 &&
          data.width <= 4096 &&
          data.height is int &&
          data.height > 0 &&
          data.height <= 4096 &&
          data.bytes is int &&
          data.bytes > 0 &&
          data.bytes <= 5 * 1024 * 1024 &&
          data.updatedAt == request.time;
    }

    // Protect each user's Firestore profile.
    match /users/{uid} {

      // Only the verified profile owner can read the document.
      allow read: if ownsProfile(uid) && hasVerifiedEmail();

      // Create the profile and reserve its username in the same transaction.
      allow create: if ownsProfile(uid) &&
          validProfile(request.resource.data) &&
          request.resource.data.createdAt == request.time &&
          !exists(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)) &&
          existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)) &&
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.keys().hasOnly(['uid']) &&
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.uid == uid;

      // Username change (Edit Profile). Only the owner, only the username
      // fields; email and createdAt must stay the same.
      allow update: if ownsProfile(uid) &&
          validProfile(request.resource.data) &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            // Same name, only capitalization changed: the reservation stays.
            request.resource.data.normalizedUsername == resource.data.normalizedUsername ||
            // New name: reserve it for this user and release the old one in the same write.
            (
              !exists(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)) &&
              getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.normalizedUsername)).data.uid == uid &&
              !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.normalizedUsername))
            )
          );

      // Prevent users from deleting their profile.
      allow delete: if false;

      // Store the user's profile-image metadata.
      match /media/{mediaId} {

        // Only the owner can read the profile image metadata.
        allow get: if mediaId == 'profile' && ownsProfile(uid);

        allow list: if false;

        // Allow valid image metadata only when the profile exists.
        allow create, update: if mediaId == 'profile' &&
            ownsProfile(uid) &&
            exists(/databases/$(database)/documents/users/$(uid)) &&
            validProfileImage(uid, request.resource.data);

        // Only the owner can delete their profile image metadata.
        allow delete: if mediaId == 'profile' && ownsProfile(uid);
      }

      // Sprint 2 farm data (see lib/models/ for the fields of each document).
      // Only the signed-in owner reaches it, and every write is checked.

      // The user's plants.
      match /plants/{plantId} {
        allow read, delete: if ownsFarm(uid);
        allow create: if ownsFarm(uid) &&
            validPlant(request.resource.data);

        allow update: if ownsFarm(uid) &&
            validPlant(request.resource.data) &&
            request.resource.data.cropId == resource.data.cropId &&
            request.resource.data.createdAt == resource.data.createdAt;

        // Each plant's growth timeline.
        match /growth/{entryId} {
          allow read, delete: if ownsFarm(uid);
          allow create, update: if ownsFarm(uid) &&
              validGrowthEntry(request.resource.data);
        }
      }

      // Finished tasks, one document per day (yyyy-mm-dd). Never deleted,
      // because the streak is checked against them.
      match /taskLog/{date} {
        allow read: if ownsFarm(uid);
        allow create, update: if ownsFarm(uid) &&
            date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            validTaskLog(request.resource.data);
        allow delete: if false;
      }

      // Streak and number of lands (the "summary" document only).
      match /stats/{docId} {
        allow read: if ownsFarm(uid);
        allow create: if ownsFarm(uid) && docId == 'summary' &&
            validStats(request.resource.data) &&
            request.resource.data.currentStreak <= 1;
        allow update: if ownsFarm(uid) && docId == 'summary' &&
            validStats(request.resource.data) &&
            validStreakChange(resource.data.currentStreak,
                              request.resource.data.currentStreak);
        allow delete: if false;
      }
    }

    // Reserve unique usernames for verified users.
    match /usernames/{normalizedUsername} {

      // Anyone can check if a single username is taken, so sign up can warn
      // before the account exists. Listing all usernames stays blocked.
      allow get: if true;

      allow list: if false;

      // Reserve a username when creating a new profile.
      allow create: if hasVerifiedEmail() &&
          validNormalizedUsername(normalizedUsername) &&
          request.resource.data.keys().hasAll(['uid']) &&
          request.resource.data.keys().hasOnly(['uid']) &&
          request.resource.data.uid == request.auth.uid &&
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          validProfile(
              getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername == normalizedUsername &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdAt == request.time;

      // Rename: the user's profile already exists, used a different name
      // before this write, and uses this name after it.
      allow create: if hasVerifiedEmail() &&
          validNormalizedUsername(normalizedUsername) &&
          request.resource.data.keys().hasAll(['uid']) &&
          request.resource.data.keys().hasOnly(['uid']) &&
          request.resource.data.uid == request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername != normalizedUsername &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername == normalizedUsername;

      // Prevent changes to an existing username reservation.
      allow update: if false;

      // Release an old name: only its owner, and only once their profile no
      // longer uses it.
      allow delete: if hasVerifiedEmail() &&
          resource.data.uid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedUsername != normalizedUsername;
    }

    // Climate cache of the recommendation API. Only the server writes it,
    // through the Admin SDK, which does not go through these rules.
    match /climate_cache/{area} {
      allow read, write: if false;
    }

    // Deny access to all other Firestore documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
